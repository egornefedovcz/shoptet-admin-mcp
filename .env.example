# Bare origin of the shop, no path: https://myshop.myshoptet.com (or your own domain)
SHOPTET_URL=
# An admin user. Prefer a dedicated user with only the rights you need.
SHOPTET_EMAIL=
SHOPTET_PASSWORD=

# Write tools are not registered unless this is 1. Leave unset for read-only.
# SHOPTET_ALLOW_WRITE=1

# Minimum pause between page loads, in ms (never below 1000). Shoptet's firewall blocks bursts.
# SHOPTET_MIN_DELAY_MS=2500

# Where drafts and the audit log are kept (default ~/.shoptet-admin-mcp, mode 0700).
# SHOPTET_STATE_DIR=

# Show the browser window while debugging.
# SHOPTET_HEADED=1
